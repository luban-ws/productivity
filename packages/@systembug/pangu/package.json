{
  "name": "@systembug/pangu",
  "version": "0.1.0",
  "description": "盘古 - 交互式开发服务器启动工具，从配置文件读取 demo 列表",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pangu": "./dist/cli-entry.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-cli.js",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@systembug/tongyu": "workspace:*",
    "ink": "^7.1.0",
    "js-yaml": "^4.1.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "globals": "^17.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luban-ws/productivity.git",
    "directory": "packages/@systembug/pangu"
  },
  "keywords": [
    "cli",
    "dev-server",
    "monorepo",
    "development-tool"
  ]
}
