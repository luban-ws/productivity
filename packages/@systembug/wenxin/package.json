{
  "name": "@systembug/wenxin",
  "version": "0.0.12",
  "description": "文心 - 通用 API 文档生成工具，支持 JSDoc 和 TypeScript",
  "private": true,
  "keywords": [
    "jsdoc",
    "typescript",
    "api-docs",
    "documentation",
    "generator"
  ],
  "author": "Albert Li <albert_lee@hotmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "wenxin": "./dist/cli.mjs",
    "wx": "./dist/cli.mjs"
  },
  "files": [
    "dist/",
    "schemas/",
    "jsdoc-template/",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./schemas": "./schemas/config.schema.json",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "chalk": "^4.1.2",
    "commander": "^9.5.0",
    "glob": "^10.3.10",
    "jsdoc": "^4.0.2",
    "ora": "^9.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
