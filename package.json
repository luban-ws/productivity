{
  "name": "productivity",
  "version": "0.0.13",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:pages": "pnpm --filter @luban-ws/productivity build:pages",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "dev": "NODE_OPTIONS='--disable-warning=DEP0040 --disable-warning=DEP0169' pangu",
    "release": "NODE_OPTIONS='--disable-warning=DEP0040 --disable-warning=DEP0169' qingniao",
    "release:trace": "node --trace-deprecation $(pnpm bin qingniao)"
  },
  "pnpm": {
    "overrides": {
      "punycode": "2.3.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@systembug/pangu": "workspace:*",
    "@systembug/qingniao": "workspace:*",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "mermaid": "^11.12.2",
    "turbo": "^2.3.3",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.0.0",
  "volta": {
    "node": "22.10.0",
    "pnpm": "9.0.0"
  },
  "dependencies": {
    "changeset": "^0.2.6"
  }
}
