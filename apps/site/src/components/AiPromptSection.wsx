/** @jsxImportSource @wsxjs/wsx-core */
/**
 * AiPromptSection — 首页 AI 一行提示词（盘古 + 青鸟）
 */
import { WebComponent, autoRegister, state } from "@wsxjs/wsx-core";
import { i18n, i18nInstance } from "@wsxjs/wsx-i18next";
import "@wsxjs/wsx-base-components";
import "@wsxjs/wsx-router";
import styles from "./AiPromptSection.css?inline";
import { AI_PROMPT_DOC_PATH, getAiPromptOneLiner } from "../data/ai-prompt";
import "./CopyCodeBlock.wsx";

@autoRegister({ tagName: "ai-prompt-section" })
@i18n("home")
export default class AiPromptSection extends WebComponent {
    @state private currentLanguage = "en";

    constructor() {
        super({ styles, styleName: "ai-prompt-section" });
    }

    protected onConnected(): void {
        super.onConnected?.();
        this.currentLanguage = i18nInstance.language || "en";
        i18nInstance.on("languageChanged", this.handleLanguageChanged);
    }

    protected onDisconnected(): void {
        super.onDisconnected?.();
        i18nInstance.off("languageChanged", this.handleLanguageChanged);
    }

    private handleLanguageChanged = (lang: string): void => {
        this.currentLanguage = lang;
        this.rerender();
    };

    render() {
        const prompt = getAiPromptOneLiner(this.currentLanguage);

        return (
            <section class="ai-prompt-section" id="ai-prompt">
                <div class="container">
                    <div class="ai-prompt-header">
                        <span class="ai-prompt-badge">{this.t("ai.badge")}</span>
                        <h2 class="ai-prompt-title">{this.t("ai.title")}</h2>
                        <p class="ai-prompt-description">{this.t("ai.description")}</p>
                    </div>
                    <div class="ai-prompt-card">
                        <copy-code-block code={prompt}></copy-code-block>
                        <div class="ai-prompt-actions">
                            <wsx-link to={AI_PROMPT_DOC_PATH} class="ai-prompt-full-link">
                                {this.t("ai.viewFull")}
                            </wsx-link>
                        </div>
                    </div>
                </div>
            </section>
        );
    }
}
