/**
 * @jsxImportSource @wsxjs/wsx-core
 * DocSection Component
 *
 * Documentation section component for the site package.
 * Manages layout and ensures content is not cut off by the navigation header.
 */

import { LightComponent, autoRegister } from "@wsxjs/wsx-core";
import styles from "./DocSection.css?inline";
import { scheduleEnhanceDocMarkedCodeBlocks } from "../utils/enhance-doc-code-blocks";
import "./CopyCodeBlock.wsx";

/**
 * DocSection Component
 *
 * Wraps the DocPage component to provide proper layout structure
 * for the site package, ensuring content is not cut off by navigation.
 */
@autoRegister({ tagName: "doc-section" })
export default class DocSection extends LightComponent {
    private docObserver: MutationObserver | null = null;

    constructor() {
        super({
            styles,
            styleName: "doc-section",
        });
    }

    protected onConnected(): void {
        super.onConnected?.();
        this.upgradeDocCodeBlocks();
        this.observeDocContent();
    }

    protected onDisconnected(): void {
        super.onDisconnected?.();
        this.docObserver?.disconnect();
        this.docObserver = null;
    }

    render() {
        return (
            <div class="doc-section-content">
                <div class="doc-section-container">
                    <wsx-doc-layout></wsx-doc-layout>
                </div>
            </div>
        );
    }

    private observeDocContent(): void {
        const root = this.getDocRoot();
        if (!root) {
            requestAnimationFrame(() => this.observeDocContent());
            return;
        }

        this.docObserver = new MutationObserver(() => {
            this.upgradeDocCodeBlocks();
        });

        this.docObserver.observe(root, {
            childList: true,
            subtree: true,
            characterData: true,
        });
    }

    private getDocRoot(): ParentNode | null {
        return this.querySelector("wsx-doc-layout") ?? document.querySelector("wsx-doc-layout");
    }

    private upgradeDocCodeBlocks(): void {
        const root = this.getDocRoot();
        if (!root) {
            return;
        }

        scheduleEnhanceDocMarkedCodeBlocks(root);
    }
}
